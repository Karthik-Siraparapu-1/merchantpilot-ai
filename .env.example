# MerchantPilot AI — Environment Configuration Template

# Node Environment
NODE_ENV=development
PORT=3001

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://merchantpilot:merchantpilot_pass@localhost:5432/merchantpilot_db?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# LLM & AI Engine Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# Feature Flags
ENABLE_DEMO_MODE=true
ENABLE_VOICE_AI=true
ENABLE_MULTI_TENANCY=true
